//-----------------------------------------------------------------------------
//	game_shader_dx9.vpc
//
//	Project Script for mods to use an an example of how to override shaders
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME "mod_episodic"
$Include "$SRCDIR\materialsystem\stdshaders\game_shader_dx9_base.vpc"

$Project "Shaders (Episodic)"
{
	$Folder "Header Files"
	{
		$File	"common_vertexlitgeneric_dx9.h"
		$File	"common_lightmappedgeneric_fxc.h"
		$File	"common_flashlight_fxc.h"
		$File	"common_fog_ps_fxc.h"
		$File	"common_fog_ps_supportsvertexfog_fxc.h"
		$File	"common_fog_vs_fxc.h"
		$File	"common_ps_fxc.h"
		
	}

	$Folder "Shader Source"
	{
		$Folder "fxc"
		{
			$File	"pbr_ps30.fxc"
			$File	"pbr_vs30.fxc"
			$File	"pbr_ps20b.fxc"
			$File	"pbr_vs20b.fxc"
			$File	"flowmappedwater_ps2x.fxc"
			$File	"flowmappedWater_vs20.fxc"
			$File	"flowmappedWaterCheap_ps2x.fxc"
			$File	"flowmappedWaterCheap_vs20.fxc"				
		}

		$File	"mymod_dx9_30.txt"
		$File	"mymod_dx9_20b.txt"
	}

	$Folder "Source Files"
	{
		$File	"pbr_dx9.cpp"
		$File	"flowmappedwater.cpp"
	}
}